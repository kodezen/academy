# === Vendor: ship the runtime autoloader + Strauss output + AS + license SDK ===
# Runtime requires:
#   - vendor/prefixed/autoload.php (mpdf + prefixed deps)
#   - vendor/woocommerce/action-scheduler/action-scheduler.php
#   - vendor/storeengine/wordpress-sdk/init.php (licensing SDK, not prefixed)
# academy.php does not require Composer's root autoloader at runtime (it loads
# the SDK directly), BUT the license SDK's updater aborts an update when the
# package is missing any `critical_paths` file, and that list DEFAULTS to
# ['vendor/autoload.php'] (SE_License_SDK_Updater::get_critical_paths). So we
# ship vendor/autoload.php + vendor/composer/ to satisfy that integrity check
# and stay consistent with academy-pro. Un-prefixed Strauss sources + dev
# packages are still excluded below.
vendor/*
!vendor/prefixed
!vendor/woocommerce
!vendor/storeengine
!vendor/composer
!vendor/autoload.php

# === Bloat in shipped runtime deps ===
vendor/prefixed/mpdf/mpdf/ttfonts/
vendor/prefixed/**/CHANGELOG*
vendor/prefixed/**/UPGRADING*
vendor/prefixed/**/.github
vendor/prefixed/**/tests
vendor/prefixed/**/Tests
vendor/prefixed/**/test
vendor/prefixed/**/.phpunit*
vendor/**/CHANGELOG*
vendor/**/changelog.txt
vendor/**/UPGRADING*
vendor/**/README*
vendor/**/readme.txt
vendor/**/composer.json
vendor/**/.github
vendor/**/tests
vendor/**/Tests
vendor/**/test
vendor/**/.phpunit*
# Composer's leftover partial-download temp files (from an interrupted install).
# Not real deps — one of these bloated the release zip from 12 MB to 36 MB.
vendor/composer/tmp-*

# BEGIN dev-package excludes (auto-generated from composer.lock packages-dev)
# Runtime never loads these; keeps the dist zip lean even when the zip is
# built from a dev vendor tree. Each entry is a packages-dev package, so
# excluding it can never drop a prod dependency.
vendor/bin/
vendor/dealerdirect/phpcodesniffer-composer-installer/
vendor/doctrine/instantiator/
vendor/nikic/php-parser/
vendor/phar-io/manifest/
vendor/phar-io/version/
vendor/phpcompatibility/php-compatibility/
vendor/phpcompatibility/phpcompatibility-paragonie/
vendor/phpcompatibility/phpcompatibility-wp/
vendor/phpunit/php-code-coverage/
vendor/phpunit/php-file-iterator/
vendor/phpunit/php-invoker/
vendor/phpunit/php-text-template/
vendor/phpunit/php-timer/
vendor/phpunit/phpunit/
vendor/sebastian/cli-parser/
vendor/sebastian/code-unit/
vendor/sebastian/code-unit-reverse-lookup/
vendor/sebastian/comparator/
vendor/sebastian/complexity/
vendor/sebastian/diff/
vendor/sebastian/environment/
vendor/sebastian/exporter/
vendor/sebastian/global-state/
vendor/sebastian/lines-of-code/
vendor/sebastian/object-enumerator/
vendor/sebastian/object-reflector/
vendor/sebastian/recursion-context/
vendor/sebastian/resource-operations/
vendor/sebastian/type/
vendor/sebastian/version/
vendor/squizlabs/php_codesniffer/
vendor/theseer/tokenizer/
vendor/wp-coding-standards/wpcs/
vendor/yoast/phpunit-polyfills/
# END dev-package excludes

