{
  "slug": "academy",
  "textdomain": "academy",
  "mainFile": "academy.php",
  "languages": "languages",
  "zipName": "{slug}.{version}.zip",
  "outputDir": "..",

  "versionFrom": "header",

  "steps": { "js": true, "composer": true, "strauss": false, "pot": true, "zip": true },

  "js": { "install": "auto", "installCommand": "npm ci --legacy-peer-deps", "buildScript": "build" },

  "composer": {
    "command": "composer run build"
  },

  "pot": {
    "exclude": ["node_modules", "vendor", "dev_academy", "dev_academy-pro", "assets/lib", "openspec", "tests", "test-results", ".git", "languages"]
  },

  "autoDownloadTools": true,
  "toolVersions": { "wpCli": "2.12.0", "strauss": "0.19.3" }
}
